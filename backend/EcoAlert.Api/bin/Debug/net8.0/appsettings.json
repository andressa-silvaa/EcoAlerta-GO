{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Connection string para banco de dados remoto (configurar conforme o serviço escolhido)
    // Exemplos de serviços gratuitos:
    // 
    // MongoDB Atlas:
    // "DefaultConnection": "mongodb+srv://usuario:senha@cluster.mongodb.net/ecoalerta?retryWrites=true&w=majority"
    //
    // PostgreSQL (Supabase):
    // "DefaultConnection": "Host=db.xxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=xxxxx"
    //
    // SQL Server (Railway/Render):
    // "DefaultConnection": "Server=xxxxx.railway.app;Database=ecoalerta;User Id=postgres;Password=xxxxx;"
    //
    // Por enquanto, usando InMemory para desenvolvimento
    "DefaultConnection": ""
  },
  "InpeApi": {
    // Base oficial do Programa Queimadas/INPE. O endpoint "focos" expõe os focos ativos em formato JSON.
    "BaseUrl": "https://terrabrasilis.dpi.inpe.br/queimadas/geoserver/",
    "Resource": "wfs",
    "LayerTemplate": "dados_abertos:focos_{0}_br_todosats",
    "CurrentYearLayer": "dados_abertos:focos_ano_atual_br_todosats",
    "DefaultPais": "Brasil",
    "DefaultEstado": "GO",
    "EstadoFiltro": "GOIÁS",
    "TimeoutSeconds": 30,
    // Caso o INPE venha a exigir autenticação, informe aqui o token (mantém vazio por padrão).
    "ApiToken": "",
    "MaxFeatures": 10000,
    "OutputFormat": "application/json"
  }
}
